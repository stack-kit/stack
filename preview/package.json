{
	"name": "stack-preview",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:static": "PREVIEW_STATIC=1 vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output machine",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && if grep -nE '^[[:space:]]*(:root|[.]dark|@theme)' src/routes/layout.css; then echo 'check: src/routes/layout.css holds the lines above. Remove them: the theme comes from ../themes/ and ../stack.css, never from layout.css.' >&2; exit 1; fi && if grep -snE '^[[:space:]]*(:root|[.]dark)' src/lib/examples/*/product-theme.css; then echo 'check: a product-theme.css holds the lines above. Remove them: it holds @theme inline aliases and no value.' >&2; exit 1; fi"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.55.0",
		"@shadcn-svelte/primitives": "0.0.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "20.19.43",
		"bits-ui": "2.19.5",
		"cn": "0.4.0",
		"embla-carousel-svelte": "8.6.0",
		"formsnap": "2.0.1",
		"layerchart": "2.7.0",
		"lean-qr": "2.7.4",
		"mode-watcher": "1.1.0",
		"paneforge": "1.0.2",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-sonner": "1.2.1",
		"sveltekit-superforms": "2.31.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.4",
		"yaml": "2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
